---
// Visore delle foto: al tocco una foto della galleria «Lo studio» o di una pagina servizio (.foto-sala)
// si apre a tutto schermo. Si chiude col tocco sullo sfondo, con Esc e con la freccia indietro del telefono
// (una voce nella cronologia). Si scorre fra le foto dello stesso gruppo con le frecce, i tasti ← → o lo swipe.
// Nessuna libreria: un <dialog> e poche righe di script.
---
<dialog class="visore" aria-label="Foto ingrandita">
  <figure>
    <img alt="" />
    <figcaption></figcaption>
  </figure>
  <button class="v-chiudi" type="button" aria-label="Chiudi">×</button>
  <button class="v-prec" type="button" aria-label="Foto precedente">‹</button>
  <button class="v-succ" type="button" aria-label="Foto successiva">›</button>
</dialog>

<style is:global>
  .galleria img, .foto-sala img { cursor: zoom-in; }
  .visore { border: 0; padding: 0; margin: 0; width: 100vw; height: 100dvh; max-width: none; max-height: none; background: #0c1016; color: #fff; }
  .visore::backdrop { background: #0c1016; }
  .visore figure { margin: 0; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 3.2rem 1rem 1rem; box-sizing: border-box; }
  .visore img { max-width: 100%; max-height: calc(100dvh - 8rem); object-fit: contain; border-radius: 8px; touch-action: pan-y; }
  .visore figcaption { margin-top: .8rem; max-width: 720px; text-align: center; font-size: .95rem; line-height: 1.45; opacity: .9; }
  .visore button { position: absolute; border: 0; background: rgba(255,255,255,.12); color: #fff; border-radius: 999px; width: 44px; height: 44px; font-size: 1.6rem; line-height: 1; cursor: pointer; display: grid; place-items: center; }
  .visore button:hover, .visore button:focus-visible { background: rgba(255,255,255,.24); outline: none; }
  .visore .v-chiudi { top: .8rem; right: .8rem; }
  .visore .v-prec { left: .8rem; top: 50%; transform: translateY(-50%); }
  .visore .v-succ { right: .8rem; top: 50%; transform: translateY(-50%); }
  .visore.solo .v-prec, .visore.solo .v-succ { display: none; }
  @media (max-width: 700px) { .visore .v-prec, .visore .v-succ { top: auto; bottom: 1rem; transform: none; } }
</style>

<script is:inline>
(() => {
  const d = document.querySelector('dialog.visore');
  if (!d || typeof d.showModal !== 'function') return;
  const img = d.querySelector('img'), cap = d.querySelector('figcaption');
  let gruppo = [], i = 0, conStoria = false;
  // Le foto dello stesso gruppo: la galleria della home, oppure tutte le .foto-sala della pagina.
  const gruppoDi = (el) => {
    const gal = el.closest('.galleria');
    return gal ? [...gal.querySelectorAll('img')] : [...document.querySelectorAll('.foto-sala img')];
  };
  const mostra = (k) => {
    i = (k + gruppo.length) % gruppo.length;
    const src = gruppo[i];
    const grande = src.currentSrc && !src.currentSrc.includes('-640.') ? src.currentSrc : src.src.replace('-640.', '.');
    img.src = grande;
    img.alt = src.alt;
    const fc = src.closest('figure')?.querySelector('figcaption');
    cap.textContent = fc ? fc.textContent : src.alt;
  };
  const apri = (el) => {
    gruppo = gruppoDi(el);
    d.classList.toggle('solo', gruppo.length < 2);
    mostra(gruppo.indexOf(el));
    d.showModal();
    history.pushState({ visore: true }, '');
    conStoria = true;
  };
  const chiudi = () => { if (!d.open) return; d.close(); };
  d.addEventListener('close', () => { if (conStoria) { conStoria = false; history.back(); } });
  window.addEventListener('popstate', () => { if (d.open) { conStoria = false; d.close(); } });
  document.querySelectorAll('.galleria img, .foto-sala img').forEach((el) => {
    el.setAttribute('tabindex', '0');
    el.setAttribute('role', 'button');
    el.addEventListener('click', () => apri(el));
    el.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); apri(el); } });
  });
  d.querySelector('.v-chiudi').addEventListener('click', chiudi);
  d.querySelector('.v-prec').addEventListener('click', (e) => { e.stopPropagation(); mostra(i - 1); });
  d.querySelector('.v-succ').addEventListener('click', (e) => { e.stopPropagation(); mostra(i + 1); });
  // Tocco sullo sfondo (fuori dalla foto e dai bottoni): chiude.
  d.addEventListener('click', (e) => { if (e.target === d || e.target.tagName === 'FIGURE') chiudi(); });
  d.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') mostra(i + 1);
    if (e.key === 'ArrowLeft') mostra(i - 1);
  });
  // Swipe orizzontale sul telefono.
  let x0 = null;
  d.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
  d.addEventListener('touchend', (e) => {
    if (x0 === null) return;
    const dx = e.changedTouches[0].clientX - x0; x0 = null;
    if (Math.abs(dx) > 50 && gruppo.length > 1) mostra(dx < 0 ? i + 1 : i - 1);
  });
})();
</script>
