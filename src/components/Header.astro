---
import CtaContatti from './CtaContatti.astro';
const { attiva = '' } = Astro.props;
const voci = [
  { href: '/servizi', label: 'Servizi', key: 'servizi' },
  // { href: '/problemi', label: 'Problemi del piede', key: 'problemi' }, // si attiva quando le pagine escono dalla bozza
  { href: '/laura-zanoni', label: 'Chi è Laura Zanoni', key: 'laura' },
  { href: '/#dove-siamo', label: 'Dove siamo e orari', key: 'dove' },
];
---
<header class="sito">
  <div class="contenitore barra">
    <a href="/" class="marchio" aria-label="Clinica Risorgimento"><img src="/img/logo.png" alt="Clinica Risorgimento" /></a>
    <div class="cta-coppia-mobile"><CtaContatti stile="compatto" etichetta="Chiama" /></div>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu-principale" aria-label="Apri il menu">
      <span></span><span></span><span></span>
    </button>
    <nav class="principale" id="menu-principale" aria-label="Principale">
      {voci.map((v) => (
        <a href={v.href} aria-current={attiva === v.key ? 'page' : undefined}>{v.label}</a>
      ))}
      <CtaContatti stile="compatto" mostraNumero={true} />
    </nav>
  </div>
</header>
<script>
  const bottone = document.querySelector('.menu-toggle');
  bottone?.addEventListener('click', () => {
    const aperto = bottone.getAttribute('aria-expanded') === 'true';
    bottone.setAttribute('aria-expanded', String(!aperto));
    bottone.setAttribute('aria-label', aperto ? 'Apri il menu' : 'Chiudi il menu');
    document.body.classList.toggle('menu-aperto', !aperto);
  });
</script>
