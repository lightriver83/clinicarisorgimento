---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import CtaContatti from './CtaContatti.astro';
const { titolo, titoloSeo, descrizione, path, icona } = Astro.props;
// Le altre pagine di servizio, per i link «vedi anche»: ogni pagina rimanda alle altre,
// così Google le raggiunge da ogni punto del sito e non solo dalla home.
const servizi = [
  { path: '/servizi/podologia', nome: 'Podologia' },
  { path: '/servizi/unghie', nome: 'Unghie: incarnita, micosi, ispessita' },
  { path: '/servizi/plantari-su-misura', nome: 'Plantari su misura' },
  { path: '/servizi/posturologia', nome: 'Posturologia' },
  { path: '/servizi/osteopatia', nome: 'Osteopatia' },
];
const altri = servizi.filter((s) => s.path !== path);
const schemaExtra = [{
  "@type": "MedicalWebPage",
  "@id": `https://clinicarisorgimento.it${path}#pagina`,
  "url": `https://clinicarisorgimento.it${path}`,
  "name": titoloSeo,
  "about": { "@id": "https://clinicarisorgimento.it/#clinica" },
  "inLanguage": "it-IT"
}];
---
<Base title={titoloSeo} description={descrizione} path={path} schemaExtra={schemaExtra}>
  <Header attiva="servizi" />
  <main>
    <div class="testata-pagina">
      <div class="contenitore">
        <p class="briciole"><a href="/">Clinica Risorgimento</a> › <a href="/servizi">Servizi</a> › {titolo}</p>
        <h1>{titolo}</h1>
        <p class="sottotitolo">{descrizione}</p>
      </div>
    </div>
    <div class="contenitore articolo">
      <slot />
      <p class="nota">Le informazioni di questa pagina hanno carattere informativo e non sostituiscono una visita. Le prestazioni sono erogate da professionisti abilitati, ciascuno nell'ambito delle proprie competenze.</p>
      <nav class="vedi-anche" aria-label="Altri servizi">
        <h2>Vedi anche</h2>
        <ul>{altri.map((s) => <li><a href={s.path}>{s.nome}</a></li>)}</ul>
      </nav>
      <div class="riquadro-prenota">
        <div><strong>Prenotare una visita</strong><span>Su appuntamento, dal lunedì al venerdì 8.30–19.30 · anche su WhatsApp</span></div>
        <CtaContatti />
      </div>
    </div>
  </main>
  <Footer />
</Base>
