import PaginaProblema from '../../components/PaginaProblema.astro';
const faq = [
  { d: "Posso farlo scoppiare da solo?",
    r: "No. Spremere o bucare spinge l'infezione in profondità. I pediluvi caldi aiutano la raccolta ad aprirsi da sola; se non lo fa entro 48 ore, deve aprirla il medico." },
  { d: "Quanto dura?",
    r: "Se la causa viene tolta e il dito viene tenuto pulito e asciutto, tre-cinque giorni. Se resta dentro un bordo di unghia che punge, può andare avanti settimane a fasi alterne." },
  { d: "Serve l'antibiotico?",
    r: "Lo decide il medico. Nei giraditi superficiali del piede, tolta la causa e con le medicazioni giuste, spesso non serve. Serve più facilmente se il gonfiore prende tutto il dito, se c'è febbre o se hai il diabete." },
  { d: "Posso andare in piscina o correre?",
