---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CtaContatti from '../../components/CtaContatti.astro';
const pagine = [
  { href: '/problemi/unghia-incarnita', nome: 'Unghia incarnita', testo: 'Dolore al bordo dell\'alluce, rossore, a volte pus. Cosa fare nei primi giorni e quando smettere di curarla da soli.' },
  { href: '/problemi/giradito', nome: 'Giradito: pus vicino all\'unghia', testo: 'Dito rosso e gonfio che pulsa, con la bollicina gialla. Le prime 48 ore, cosa non fare, quando serve il medico.' },
  { href: '/problemi/unghia-nera', nome: 'Unghia nera', testo: 'Dopo una corsa, una scarpa stretta o un colpo. Cosa succede sotto, quando cade, e quali macchie vanno fatte vedere.' },
  { href: '/problemi/unghia-gialla-spessa', nome: 'Unghia gialla e spessa: è un fungo?', testo: 'Una volta su due non lo è. Come si distingue e perché gli smalti antimicotici spesso non funzionano.' },
];
const pelle = [
  { href: '/problemi/verruca-plantare', nome: 'Verruca sotto il piede', testo: 'Un punto duro sotto la pianta che fa male quando lo stringi. Verruca o callo, cosa fare a casa e quando farla vedere.' },
  { href: '/problemi/calli-duroni', nome: 'Calli, duroni e occhio di pernice', testo: 'Il callo con il nucleo che punge, il durone sotto la pianta, l\'occhio di pernice fra le dita. Perché tornano.' },
  { href: '/problemi/talloni-screpolati', nome: 'Talloni screpolati e ragadi', testo: 'Pelle dura sul bordo del tallone che si spacca e a volte sanguina. Cosa mettere a casa e quando la crepa va medicata.' },
  { href: '/problemi/piedi-sudati-odore', nome: 'Piedi che sudano e che puzzano', testo: 'Sudore che bagna le calze, odore nelle scarpe, pelle bianca fra le dita. Cosa funziona a casa e quando c\'entra un fungo.' },
];
const dolore = [
  { href: '/problemi/dolore-tallone', nome: 'Dolore al tallone appena alzati', testo: 'Una fitta sotto il tallone ai primi passi del mattino, che si scioglie camminando. Cosa fare a casa, quanto dura e quando farlo vedere.' },
  { href: '/problemi/dolore-pianta-piede', nome: 'Dolore sotto la pianta, verso le dita', testo: 'Come camminare su un sasso, o una scossa fra le dita. Cosa fare a casa e quali segnali sono del medico.' },
  { href: '/problemi/alluce-valgo', nome: 'Alluce valgo', testo: 'La «cipolla» alla base dell\'alluce che sfrega nella scarpa. Cosa aiuta davvero e quando è il momento dell\'ortopedico.' },
  { href: '/problemi/dito-a-martello', nome: 'Dito a martello', testo: 'Il secondo dito che si piega, con il callo sulla nocca. Cosa aiuta finché è flessibile e quando serve l\'ortopedico.' },
];
---
<Base
  title="Problemi del piede: cosa fare, spiegato da chi li cura | Forlì"
  description="Unghia incarnita, giradito, unghia nera, unghia gialla e spessa, verruca sotto il piede: cosa fare e quando farlo vedere, spiegato dalla Dott.ssa Laura Zanoni."
  path="/problemi"
>
  <Header attiva="problemi" />
  <main>
    <div class="testata-pagina">
      <div class="contenitore">
        <p class="briciole"><a href="/">Clinica Risorgimento</a> › Problemi del piede</p>
        <h1>Problemi del piede: cosa fare, spiegato da chi li cura</h1>
        <p class="sottotitolo">Queste pagine partono da come le persone descrivono il problema, non dal nome tecnico. In testa a ogni pagina c'è chi l'ha scritta: alcune la <a href="/laura-zanoni">Dott.ssa Laura Zanoni</a>, altre la clinica. Dicono cosa fare a casa, cosa non fare, quando venire e quando invece serve il medico.</p>
      </div>
    </div>
    <div class="contenitore articolo" style="max-width:1000px;">
      <h2 style="margin-top:0;">Unghie</h2>
      <div class="griglia-schede" style="margin-top:1rem;">
        {pagine.map((p) => (
          <a class="scheda" href={p.href}>
            <h3>{p.nome}</h3>
            <p>{p.testo}</p>
          </a>
        ))}
      </div>
      <h2>Pelle del piede</h2>
      <div class="griglia-schede" style="margin-top:1rem;">
        {pelle.map((p) => (
          <a class="scheda" href={p.href}>
            <h3>{p.nome}</h3>
            <p>{p.testo}</p>
          </a>
        ))}
      </div>
      <h2>Dolore al piede</h2>
      <div class="griglia-schede" style="margin-top:1rem;">
        {dolore.map((p) => (
          <a class="scheda" href={p.href}>
            <h3>{p.nome}</h3>
            <p>{p.testo}</p>
          </a>
        ))}
      </div>
      <p class="nota" style="margin-top:2.4rem;">Se il tuo problema non è qui, prenota un controllo in studio: al telefono o su WhatsApp fissiamo l'appuntamento.</p>
      <div class="riquadro-prenota">
        <div><strong>Vuoi che lo guardiamo insieme?</strong><span>Su appuntamento in studio, lunedì–venerdì 8.30–19.30 · prenoti anche su WhatsApp</span></div>
        <CtaContatti />
      </div>
    </div>
  </main>
  <Footer />
</Base>
