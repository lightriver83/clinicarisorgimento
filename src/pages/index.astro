---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const servizi = [
  { icona: '/img/icona-podologia.webp', nome: 'Podologia', href: '/servizi/podologia',
    testo: "Dolori del piede, calli e duroni, unghie incarnite, ispessite o con micosi, verruche. Prima si capisce la causa, poi si tratta." },
  { icona: '/img/icona-posturologia.webp', nome: 'Posturologia e biomeccanica', href: '/servizi/posturologia',
    testo: "Come il piede si appoggia e come questo si riflette su ginocchia, anche e schiena. Esame baropodometrico e analisi del passo, con un referto che si legge." },
  { icona: '/img/icona-solette.webp', nome: 'Plantari e solette su misura', href: '/servizi/plantari-su-misura',
    testo: "Nascono dalla valutazione, non da un catalogo, e si controllano dopo la consegna. Se non servono, lo diciamo." },
  { icona: '/img/icona-osteopatia.webp', nome: 'Osteopatia', href: '/servizi/osteopatia',
    testo: "Trattamento manuale di articolazioni, muscoli e fasce. Qui si legge insieme al piede: un appoggio sbagliato e un mal di schiena spesso si tengono a vicenda." },
];
const altri = ['trattamenti in gravidanza', 'psicomotricità', 'ginnastica posturale', 'fisioterapia'];
const foto = ['/img/sede-1.webp','/img/sede-2.jpeg','/img/sede-3.webp','/img/sede-4.webp','/img/sede-5.webp','/img/sede-6.jpeg'];
---
<Base path="/">
  <Header />

  <main>
    <div class="eroe">
      <div class="sfondo"><img src="/img/sede-1.webp" alt="" fetchpriority="high" /></div>
      <div class="contenitore">
        <div class="contenuto">
          <p class="occhiello">Clinica Risorgimento · Forlì</p>
          <h1>Podologia, posturologia e osteopatia a Forlì</h1>
          <p>Lo studio della Dott.ssa Laura Zanoni. Si misura prima di trattare, si spiega tutto in parole semplici, e se un trattamento non serve lo diciamo.</p>
          <div class="azioni">
            <a class="bottone-chiaro" href="tel:+390543405479">Chiama ora</a>
            <a class="bottone-vuoto" href="https://wa.me/393462172234">Scrivi su WhatsApp</a>
          </div>
        </div>
      </div>
    </div>

    <section id="servizi">
      <div class="contenitore">
        <p class="occhiello-sez">Di cosa ci occupiamo</p>
        <h2>Piede, appoggio, postura, movimento</h2>
        <p class="intro-sez">Sono legati fra loro, e qui si guardano insieme. Ogni percorso parte da una valutazione con strumenti (esame baropodometrico, analisi del passo, ecografia quando serve) e si chiude con un referto scritto per essere capito: dal paziente prima, dal suo medico poi.</p>
        <div class="griglia-servizi">
          {servizi.map((s) => (
            <a class="servizio scheda" href={s.href}>
              <img src={s.icona} alt="" loading="lazy" />
              <h3>{s.nome}</h3>
              <p>{s.testo}</p>
              <p style="margin-top:.6rem;color:var(--blu);font-size:.9rem;font-weight:600;">Scopri di più →</p>
            </a>
          ))}
        </div>
        <p style="margin-top:1.6rem;color:var(--grigio);font-size:.92rem;">In studio si fanno anche {altri.join(', ')}. Per sapere se è il caso tuo: <a href="tel:+390543405479">0543 405479</a>.</p>
      </div>
    </section>

    <section id="la-clinica" class="alterna">
      <div class="contenitore">
        <p class="occhiello-sez">Lo studio</p>
        <h2>Viale Risorgimento 283, Forlì</h2>
        <p class="intro-sez">Sale separate per la podologia, la valutazione strumentale e l'osteopatia. La strumentazione è in sede: pedana baropodometrica, ecografo, laser per le unghie. Si riceve solo su appuntamento, così ogni visita ha il tempo che le serve.</p>
        <div class="galleria">
          {foto.map((f, i) => (
            <img src={f} alt={`Clinica Risorgimento, gli ambienti dello studio di Forlì — ${i + 1}`} loading="lazy" />
          ))}
        </div>
      </div>
    </section>

    <section id="direzione">
      <div class="contenitore direzione">
        <div>
          <p class="occhiello-sez">Direzione clinica</p>
          <h2>Dott.ssa Laura Zanoni</h2>
          <p class="intro-sez">Podologa dal 2006 e podiatra (laurea in Spagna, 2026), posturologa clinica, osteopata. Docente all'Istituto Zaccagnini, per dodici anni referente podologo del Piede Diabetico all'ospedale di Forlì. Segue personalmente le valutazioni iniziali e i casi complessi, e firma i protocolli con cui lavora tutta la clinica. Ha un modo suo di lavorare: far vedere al paziente quello che vede lei, e spiegarlo in parole semplici.</p>
          <p style="margin-top:1rem;"><a href="/laura-zanoni" style="font-weight:600;">Chi è Laura Zanoni →</a></p>
        </div>
        <img src="/img/sede-3.webp" alt="Clinica Risorgimento, la sala visite" loading="lazy" style="border-radius:14px;aspect-ratio:4/3;object-fit:cover;" />
      </div>
    </section>

    <section class="prenota" id="prenota">
      <div class="contenitore">
        <h2>Prenotare una visita</h2>
        <p class="numeri">
          Chiamaci al <a class="numero" href="tel:+393462172234">346 217 22 34</a>&ensp;oppure al fisso&ensp;<a class="numero" href="tel:+390543405479">0543 40 54 79</a>
        </p>
        <a class="bottone-chiaro" href="tel:+390543405479">Chiama ora</a>
      </div>
    </section>

    <section class="dove" id="dove-siamo">
      <div class="contenitore">
        <p class="occhiello-sez">Dove trovarci</p>
        <h2>Dove siamo e orari</h2>
        <div class="colonne">
          <div>
            <h3>Indirizzo</h3>
            <p>Clinica Risorgimento<br />Viale Risorgimento 283<br />47121 Forlì (FC)</p>
            <p style="margin-top:.8rem;"><a href="https://www.google.com/maps/search/?api=1&query=Clinica+Risorgimento+Viale+Risorgimento+283+Forl%C3%AC" rel="noopener">Apri in Google Maps</a></p>
          </div>
          <div>
            <h3>Orari</h3>
            <table>
              <tr><td>Lunedì – Venerdì</td><td>8.30 – 19.30</td></tr>
              <tr><td>Sabato</td><td>chiuso</td></tr>
              <tr><td>Domenica</td><td>chiuso</td></tr>
            </table>
          </div>
          <div>
            <h3>Contatti</h3>
            <p>Telefono: <a href="tel:+390543405479">0543 405479</a><br />
            WhatsApp: <a href="https://wa.me/393462172234" rel="noopener">346 2172234</a></p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
