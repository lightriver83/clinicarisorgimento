---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaContatti from '../components/CtaContatti.astro';
import { hasCredential } from '../data/laura';

// FRASE PROVVISORIA (21/9/2026): scritta da Nick nel modo di lavorare che Laura descrive
// in studio, non detta da lei. Quando Laura ne dà una sua, si sostituisce qui e basta.
const fraseDiLaura = 'Prima di trattare un piede lo misuro, e quello che vedo io te lo faccio vedere. Se un trattamento non serve te lo dico, e ti spiego il perché con parole semplici.';

const schemaExtra = [{
  "@type": "ProfilePage",
  "@id": "https://clinicarisorgimento.it/laura-zanoni#pagina",
  "url": "https://clinicarisorgimento.it/laura-zanoni",
  "name": "Dott.ssa Laura Zanoni — podologa e podiatra, posturologa, osteopata a Forlì",
  "mainEntity": {
    "@type": "Person",
    "@id": "https://clinicarisorgimento.it/#laura-zanoni",
    "name": "Laura Zanoni",
    "alternateName": ["Dott.ssa Laura Zanoni", "Dottoressa Laura Zanoni", "Laura Zanoni podologa"],
    "url": "https://clinicarisorgimento.it/laura-zanoni",
    "honorificPrefix": "Dott.ssa",
    "image": "https://clinicarisorgimento.it/img/laura-zanoni-quadrata.jpg",
    "jobTitle": "Podologa e podiatra, posturologa, osteopata",
    "workLocation": { "@type": "Place", "name": "Clinica Risorgimento", "address": { "@type": "PostalAddress", "streetAddress": "Viale Risorgimento 283", "postalCode": "47121", "addressLocality": "Forlì", "addressRegion": "FC", "addressCountry": "IT" } },
    "description": "Podologa dal 2006 e podiatra (laurea in Podiatria in Spagna, 2026), posturologa clinica, osteopata. Corso di Ecografía Podológica (World Academy of Podiatric Science, 2024). Docente del Master Clinico in Visione e Postura all'Istituto Zaccagnini dal 2014. Referente podologo dell'ambulatorio Piede Diabetico dell'Ospedale Morgagni-Pierantoni di Forlì dal 2007 al 2019. Dal 2008 guida il proprio studio a Forlì, oggi Clinica Risorgimento.",
    "sameAs": ["https://www.istitutozaccagnini.it/istituto/docenti/zanoni-laura", "https://it.linkedin.com/in/laura-zanoni-121255169", "https://www.facebook.com/clinicarisorgimento", "https://www.google.com/maps?cid=16692031514607331278"],
    "worksFor": { "@id": "https://clinicarisorgimento.it/#clinica" },
    "hasCredential": hasCredential,
    "alumniOf": [
      { "@type": "CollegeOrUniversity", "name": "Università degli Studi di Perugia" },
      { "@type": "CollegeOrUniversity", "name": "Università di Pisa" },
      { "@type": "EducationalOrganization", "name": "CRESO — Centro Ricerche e Studi in Osteopatia" }
    ],
    "knowsAbout": [
      "Podologia", "Posturologia clinica", "Osteopatia", "Podiatria",
      "Biomeccanica del passo", "Plantari su misura", "Patologie dell'unghia",
      "Ecografia podologica del piede e della caviglia", "Esame micologico dell'unghia", "Laser per onicomicosi"
    ]
  }
}];
---
<Base
  title="Dott.ssa Laura Zanoni, podologa e podiatra a Forlì"
  description="Laura Zanoni: podologa dal 2006 e podiatra (laurea in Spagna, 2026), posturologa clinica, osteopata, docente all'Istituto Zaccagnini. Direzione clinica a Forlì."
  path="/laura-zanoni"
  schemaExtra={schemaExtra}
  ogImage="https://clinicarisorgimento.it/img/laura-zanoni-quadrata.jpg"
>
  <Header attiva="laura" />
  <main>
    <div class="testata-pagina">
      <div class="contenitore">
        <p class="briciole"><a href="/">Clinica Risorgimento</a> › Chi è Laura Zanoni</p>
        <h1>Dott.ssa Laura Zanoni</h1>
        <p class="sottotitolo">Podologa e podiatra, posturologa clinica, osteopata. Direzione clinica della Clinica Risorgimento, Forlì.</p>
      </div>
    </div>

    <div class="contenitore articolo">
      <figure class="ritratto">
        <picture>
          <source srcset="/img/laura-zanoni.webp" type="image/webp" />
          <img src="/img/laura-zanoni.jpg" alt="La Dott.ssa Laura Zanoni nello studio di Viale Risorgimento, a Forlì" width="800" height="1000" />
        </picture>
        <figcaption>Laura Zanoni nello studio di Viale Risorgimento.</figcaption>
      </figure>
      <blockquote class="citazione"><p>«{fraseDiLaura}»</p></blockquote>
      <p>Laura Zanoni lavora sul piede e sulla postura dal 2006. Ha aperto il proprio studio a Forlì nel 2008 e lo ha fatto crescere fino all'attuale Clinica Risorgimento, di cui cura la direzione clinica: i protocolli di visita, gli standard di refertazione e la qualità del lavoro di chi collabora con lei.</p>

      <p>Il suo modo di lavorare parte da un principio semplice: <strong>far vedere al paziente ciò che vede lei</strong>. Ogni valutazione si appoggia a strumenti — esame baropodometrico, analisi del passo, imaging — e si chiude con un referto chiaro, che il paziente porta a casa e può mostrare al proprio medico. Non si prescrive un trattamento senza prima aver misurato; e quando non serve alcun trattamento, lo si dice. E si spiega in parole semplici: un referto che il paziente non capisce è un referto a metà.</p>

      <h2>Formazione</h2>
      <ul class="credenziali">
        <li><span class="anno">2006</span><span>Laurea in <strong>Podologia</strong>, Università degli Studi di Perugia</span></li>
        <li><span class="anno">2011</span><span><strong>Master in Posturologia clinica</strong>, Università di Pisa</span></li>
        <li><span class="anno">2018</span><span>Diploma in <strong>Osteopatia</strong>, percorso sessennale, CRESO</span></li>
        <li><span class="anno">2024</span><span>Corso di <strong>Ecografia podologica</strong>, World Academy of Podiatric Science (WAPS), Huesca — attività accreditata dalla Commissione di Formazione Continua del Sistema Sanitario Nazionale spagnolo (Aragona)</span></li>
        <li><span class="anno">2026</span><span>Laurea in <strong>Podiatria</strong>, conseguita in Spagna</span></li>
      </ul>

      <h2>Esperienza</h2>
      <ul class="credenziali">
        <li><span class="anno">2007–2019</span><span><strong>Referente podologo</strong> dell'ambulatorio <strong>Piede Diabetico</strong>, Ospedale Morgagni-Pierantoni di Forlì — dodici anni sui casi in cui il piede è una questione medica prima che podologica</span></li>
        <li><span class="anno">2010–2011</span><span>Consulente per il <strong>Cesena Calcio</strong>, prima squadra e Primavera</span></li>
        <li><span class="anno">dal 2008</span><span>Titolare del proprio studio a Forlì, oggi <strong>Clinica Risorgimento</strong></span></li>
      </ul>

      <h2>Docenza</h2>
      <p>Dal 2014 è docente del <strong>Master Clinico in Visione e Postura</strong> dell'<a href="https://www.istitutozaccagnini.it/istituto/docenti/zanoni-laura" rel="noopener">Istituto Zaccagnini</a> di Bologna. La didattica è parte del suo lavoro clinico, non un'attività a lato: ciò che insegna è ciò che applica in studio, e viceversa.</p>

      <h2>Di cosa si occupa</h2>
      <p>Alla Clinica Risorgimento segue personalmente le <strong>valutazioni iniziali</strong> — la parte in cui si decide che cosa fare — e i <strong>casi complessi</strong>. Le aree di lavoro sono la podologia e la podiatria, la posturologia e la biomeccanica del passo, i plantari su misura, le patologie dell'unghia (esame micologico con coltura, trattamento laser delle micosi, rieducazione ungueale), la valutazione ecografica di piede e caviglia — per cui ha una formazione specifica — e l'osteopatia. Le informazioni su ciascun servizio sono nella <a href="/servizi">pagina dei servizi</a>.</p>

      <p class="nota">Le prestazioni sanitarie della clinica sono erogate da professionisti abilitati, ciascuno nell'ambito delle proprie competenze e del proprio titolo. Le informazioni di questa pagina hanno carattere informativo e non sostituiscono una visita.</p>

      <div class="riquadro-prenota">
        <div><strong>Prenotare una visita</strong><span>Su appuntamento, dal lunedì al venerdì 8.30–19.30</span></div>
        <CtaContatti />
      </div>
    </div>
  </main>
  <Footer />
</Base>
