---
const {
  title = 'Clinica Risorgimento — Podologia, posturologia e osteopatia a Forlì',
  description = "Lo studio della Dott.ssa Laura Zanoni a Forlì: podologia, valutazioni posturali e biomeccaniche, plantari su misura, osteopatia e patologie dell'unghia. Su appuntamento: 0543 405479.",
  path = '/',
  noindex = false,
  schemaExtra = null,
} = Astro.props;
const canonical = new URL(path, Astro.site).href;

const schemaBase = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MedicalClinic",
      "@id": "https://clinicarisorgimento.it/#clinica",
      "name": "Clinica Risorgimento",
      "url": "https://clinicarisorgimento.it/",
      "image": "https://clinicarisorgimento.it/img/sede-1.webp",
      "logo": "https://clinicarisorgimento.it/img/logo.png",
      "telephone": "+390543405479",
      "vatID": "03658160407",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Viale Risorgimento 283",
        "postalCode": "47121",
        "addressLocality": "Forlì",
        "addressRegion": "FC",
        "addressCountry": "IT"
      },
      "openingHoursSpecification": [{
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
        "opens": "08:30",
        "closes": "19:30"
      }],
      "medicalSpecialty": "Podiatric",
      "geo": { "@type": "GeoCoordinates", "latitude": 44.1980448, "longitude": 12.0328179 },
      "hasMap": "https://www.google.com/maps?cid=16692031514607331278",
      "sameAs": [
        "https://www.google.com/maps?cid=16692031514607331278",
        "https://www.instagram.com/clinica_risorgimento/",
        "https://www.facebook.com/clinicarisorgimento"
      ],
      "areaServed": [
        { "@type": "City", "name": "Forlì" },
        { "@type": "AdministrativeArea", "name": "Romagna" }
      ],
      "founder": { "@id": "https://clinicarisorgimento.it/#laura-zanoni" },
      "employee": { "@id": "https://clinicarisorgimento.it/#laura-zanoni" }
    },
    {
      "@type": "Person",
      "@id": "https://clinicarisorgimento.it/#laura-zanoni",
      "name": "Laura Zanoni",
      "honorificPrefix": "Dott.ssa",
      "jobTitle": "Podologa, posturologa, osteopata",
      "sameAs": ["https://www.istitutozaccagnini.it/istituto/docenti/zanoni-laura", "https://it.linkedin.com/in/laura-zanoni-121255169"],
      "worksFor": { "@id": "https://clinicarisorgimento.it/#clinica" },
      "knowsAbout": [
        "Podologia", "Posturologia", "Osteopatia",
        "Patologie dell'unghia", "Plantari su misura", "Biomeccanica del passo"
      ]
    }
  ]
};
const schema = schemaExtra
  ? { ...schemaBase, "@graph": [...schemaBase["@graph"], ...schemaExtra] }
  : schemaBase;
---
<html lang="it">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content="https://clinicarisorgimento.it/img/sede-1.webp" />
  <meta property="og:locale" content="it_IT" />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body>
  <slot />
  <style is:global>
    :root {
      --blu: #0069a8;
      --blu-scuro: #084f7a;
      --inchiostro: #1d2733;
      --grigio: #5b6673;
      --carta: #ffffff;
      --fondo: #f4f7f9;
      --bordo: #e2e9ee;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      font-family: "Avenir Next", Avenir, "Segoe UI", system-ui, sans-serif;
      color: var(--inchiostro);
      background: var(--carta);
      line-height: 1.6;
    }
    img { max-width: 100%; display: block; }
    a { color: var(--blu); }
    .contenitore { max-width: 1080px; margin: 0 auto; padding: 0 1.25rem; }

    header.sito {
      position: sticky; top: 0; z-index: 50;
      background: rgba(255,255,255,.96); backdrop-filter: blur(6px);
      border-bottom: 1px solid var(--bordo);
    }
    .barra { display: flex; align-items: center; justify-content: space-between; padding: .7rem 0; gap: 1rem; }
    .barra .marchio { margin-right: auto; }
    .cta-mobile, .menu-toggle { display: none; }
    .barra img { height: 44px; width: auto; }
    nav.principale { display: flex; gap: 1.4rem; align-items: center; flex-wrap: wrap; }
    nav.principale a { color: var(--inchiostro); text-decoration: none; font-size: .95rem; font-weight: 500; }
    nav.principale a:hover { color: var(--blu); }
    .cta {
      background: var(--blu); color: #fff !important; padding: .5rem 1.1rem;
      border-radius: 999px; font-weight: 600; white-space: nowrap;
    }
    .cta:hover { background: var(--blu-scuro); }

    .eroe { position: relative; color: #fff; overflow: hidden; background: var(--inchiostro); }
    .eroe .sfondo { position: absolute; inset: 0; }
    .eroe .sfondo img { width: 100%; height: 100%; object-fit: cover; opacity: .38; }
    .eroe .contenuto { position: relative; padding: 6.5rem 0 6rem; max-width: 760px; }
    .eroe .occhiello { text-transform: uppercase; letter-spacing: .18em; font-size: .8rem; opacity: .85; }
    .eroe h1 { font-size: clamp(1.9rem, 4.5vw, 3rem); line-height: 1.15; margin: .6rem 0 1rem; font-weight: 700; }
    .eroe p { font-size: 1.1rem; max-width: 560px; opacity: .95; }
    .eroe .azioni { margin-top: 1.8rem; display: flex; gap: .9rem; flex-wrap: wrap; }
    .bottone-chiaro {
      background: #fff; color: var(--blu-scuro); text-decoration: none;
      padding: .7rem 1.4rem; border-radius: 999px; font-weight: 700;
    }
    .bottone-vuoto {
      border: 1.5px solid rgba(255,255,255,.7); color: #fff; text-decoration: none;
      padding: .7rem 1.4rem; border-radius: 999px; font-weight: 600;
    }

    section { padding: 4.5rem 0; }
    section.alterna { background: var(--fondo); }
    .occhiello-sez { color: var(--blu); text-transform: uppercase; letter-spacing: .16em; font-size: .8rem; font-weight: 700; }
    h2 { font-size: clamp(1.5rem, 3vw, 2.1rem); margin: .4rem 0 .9rem; }
    .intro-sez { color: var(--grigio); max-width: 640px; }

    .griglia-servizi {
      margin-top: 2.4rem; display: grid; gap: 1.1rem;
      grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    }
    .servizio {
      background: var(--carta); border: 1px solid var(--bordo); border-radius: 14px;
      padding: 1.5rem 1.3rem;
    }
    .servizio img { height: 52px; width: 52px; object-fit: contain; margin-bottom: .9rem; }
    .servizio h3 { font-size: 1.05rem; margin-bottom: .4rem; }
    .servizio p { font-size: .92rem; color: var(--grigio); }

    .galleria { margin-top: 2.2rem; display: grid; gap: .8rem; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
    .galleria img { border-radius: 12px; aspect-ratio: 4/3; object-fit: cover; width: 100%; }

    .prenota { background: var(--blu); color: #fff; text-align: center; }
    .prenota h2 { color: #fff; }
    .prenota .numeri { font-size: 1.25rem; margin: 1rem 0 1.6rem; }
    .prenota a.numero { color: #fff; font-weight: 700; text-decoration: none; }

    .dove .colonne { display: grid; gap: 2.4rem; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); margin-top: 2rem; }
    .dove h3 { margin-bottom: .6rem; font-size: 1.05rem; }
    .dove table { border-collapse: collapse; }
    .dove td { padding: .18rem .9rem .18rem 0; color: var(--grigio); }
    .dove td:first-child { color: var(--inchiostro); font-weight: 500; }

    footer.sito {
      background: var(--inchiostro); color: #aeb8c2; padding: 2.6rem 0; font-size: .88rem;
    }
    footer.sito img { height: 40px; margin-bottom: 1rem; }
    footer.sito a { color: #dbe3ea; }
    .legale { margin-top: .8rem; }

    /* pagine interne */
    .testata-pagina { background: var(--fondo); padding: 3.2rem 0 2.6rem; border-bottom: 1px solid var(--bordo); }
    .testata-pagina h1 { font-size: clamp(1.7rem, 3.6vw, 2.4rem); line-height: 1.2; margin: .4rem 0 .6rem; }
    .testata-pagina .sottotitolo { color: var(--grigio); max-width: 640px; font-size: 1.05rem; }
    .briciole { font-size: .85rem; color: var(--grigio); }
    .briciole a { color: var(--grigio); text-decoration: none; }
    .briciole a:hover { color: var(--blu); }
    .articolo { max-width: 720px; padding-top: 3rem; padding-bottom: 4rem; }
    .articolo h2 { font-size: 1.35rem; margin: 2rem 0 .6rem; }
    .articolo h3 { font-size: 1.08rem; margin: 1.4rem 0 .4rem; }
    .articolo p { margin: 0 0 1rem; }
    .articolo ul { margin: 0 0 1rem 1.2rem; }
    .articolo li { margin-bottom: .35rem; }
    .articolo .nota { color: var(--grigio); font-size: .92rem; border-left: 3px solid var(--bordo); padding-left: .9rem; margin: 1.4rem 0; }
    .riquadro-prenota {
      background: var(--fondo); border: 1px solid var(--bordo); border-radius: 14px;
      padding: 1.4rem 1.5rem; margin-top: 2.4rem; display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; justify-content: space-between;
    }
    .riquadro-prenota strong { display: block; margin-bottom: .2rem; }
    .riquadro-prenota span { color: var(--grigio); font-size: .92rem; }
    .credenziali { list-style: none; margin: 1.2rem 0 0; padding: 0; display: grid; gap: .6rem; }
    .credenziali li { display: grid; grid-template-columns: 5.2rem 1fr; gap: .8rem; padding: .7rem 0; border-bottom: 1px solid var(--bordo); }
    .credenziali .anno { color: var(--blu); font-weight: 700; font-variant-numeric: tabular-nums; }
    .griglia-schede { display: grid; gap: 1.1rem; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); margin-top: 2rem; }
    .scheda { background: var(--carta); border: 1px solid var(--bordo); border-radius: 14px; padding: 1.5rem 1.4rem; text-decoration: none; color: inherit; display: block; }
    .scheda:hover { border-color: var(--blu); }
    .scheda img { height: 48px; width: 48px; object-fit: contain; margin-bottom: .8rem; }
    .scheda h3 { font-size: 1.08rem; margin-bottom: .35rem; color: var(--blu-scuro); }
    .scheda p { font-size: .92rem; color: var(--grigio); }
    .direzione { display: grid; gap: 2rem; grid-template-columns: 1fr 1fr; align-items: center; }
    @media (max-width: 760px) { .direzione { grid-template-columns: 1fr; } .credenziali li { grid-template-columns: 4.2rem 1fr; } }

    @media (max-width: 700px) {
      .eroe .contenuto { padding: 4.5rem 0 4rem; }
      .barra { gap: .6rem; }
      .cta-mobile { display: inline-block; padding: .45rem .9rem; font-size: .9rem; }
      .menu-toggle {
        display: inline-flex; flex-direction: column; justify-content: center; gap: 5px;
        width: 44px; height: 44px; padding: 0 10px; border: 1px solid var(--bordo); border-radius: 10px; background: #fff; cursor: pointer;
      }
      .menu-toggle span { display: block; height: 2px; background: var(--inchiostro); border-radius: 2px; transition: transform .2s, opacity .2s; }
      .menu-toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
      .menu-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
      .menu-toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
      nav.principale {
        display: none; position: absolute; left: 0; right: 0; top: 100%;
        flex-direction: column; align-items: stretch; gap: 0;
        background: #fff; border-bottom: 1px solid var(--bordo); box-shadow: 0 12px 24px rgba(15,35,50,.08);
        padding: .3rem 1.25rem 1.1rem;
      }
      body.menu-aperto nav.principale { display: flex; }
      nav.principale a:not(.cta) { padding: .85rem 0; border-bottom: 1px solid var(--bordo); font-size: 1.05rem; }
      nav.principale a[aria-current="page"] { color: var(--blu); }
      nav.principale .cta { margin-top: .9rem; text-align: center; }
    }
  </style>
</body>
</html>
